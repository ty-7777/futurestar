<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.situ.futurestar.core.mapper.RefreshTokenMapper">
    <insert id="save" parameterType="com.situ.futurestar.core.entity.RefreshToken" keyProperty="id"   useGeneratedKeys="true">
    INSERT INTO refresh_token (user_id, token, expire_time, create_time)
    VALUES (#{userId}, #{token}, #{expireTime}, NOW())
    </insert>
    <select id="selectByToken" resultType="com.situ.futurestar.core.entity.RefreshToken">
        SELECT * FROM refresh_token
        WHERE  token = #{refreshToken} AND expire_time &gt; NOW()
    </select>
    <delete id="deleteByUserId">
        DELETE FROM refresh_token
        WHERE user_id = #{userId}
    </delete>
</mapper>